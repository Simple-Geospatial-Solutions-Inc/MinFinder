# basemap/config.env — shared configuration for the basemap pipeline.
# Copy this file to basemap/config.env and edit as needed:
#   cp config.env.example config.env
# Every build/ and serve/ script sources this file; nothing is hardcoded there.
# All relative paths are resolved against the basemap/ directory.

# Geofabrik area id for the OSM extract (auto-downloaded by Planetiler).
# See https://download.geofabrik.de/ for valid ids.
BASEMAP_AREA=british-columbia

# Scratch directory: downloads and intermediate files (OSM extract cache,
# DEM tiles, dem.vrt, temp tiles). Safe to delete between full rebuilds,
# but keeping it avoids re-downloading ~7+ GB of sources.
BASEMAP_DATA_DIR=./data

# Output directory: publishable artifacts ONLY
# (basemap.pmtiles, terrain.pmtiles, contours.pmtiles, glyphs/, sprite.*).
BASEMAP_OUT_DIR=./out

# Public hostname the tiles will be served from.
# Must match --public-url in serve/pmtiles.service and the site block in
# serve/Caddyfile.example. Needs an A record -> 51.222.206.236 before Caddy
# can complete the ACME challenge.
BASEMAP_HOST=tiles.sgss.ca

# SSH destination for serve/deploy.sh. The OVH box's login user is `ubuntu`,
# not the `deploy@` that deploy.sh would otherwise default to. Key-based auth
# is required — deploy.sh runs ssh/rsync non-interactively and cannot answer a
# password prompt.
# Point this at the ORIGIN, not at the public tile hostname. Once a CDN
# proxies that hostname it resolves to the CDN's addresses, and CDNs do not
# proxy port 22 -- SSH and rsync then fail. A ~/.ssh/config entry hides this
# on a workstation, but deploy.sh runs rsync inside a container that never
# sees that file and resolves the name for real. Use the address, or a
# second DNS-only record (e.g. origin.example.ca) aimed at the same box.
DEPLOY_SSH=ubuntu@203.0.113.10

# Target directory on the VPS; must match WorkingDirectory/ExecStart in
# serve/pmtiles.service and the `root *` paths in serve/Caddyfile.example.
DEPLOY_DIR=/srv/basemap

# JVM max heap for Planetiler (passed as -Xmx via JAVA_TOOL_OPTIONS).
# ~0.5x the .osm.pbf size is enough; BC's extract is ~1.24 GB, so 4g is ample.
PLANETILER_XMX=4g

# DEM bounding box for Copernicus GLO-30 tile fetch, in whole degrees.
# Latitudes are north, longitudes are WEST (positive numbers, W hemisphere).
# BC spans 48.2-60.0N, 114.05-139.07W; 1-degree tiles are named by their SW
# corner, so tile N59 covers up to 60N and tile W140 is needed to reach BC's
# westernmost sliver at 139.07W (the extra W140 column is mostly ocean/Alaska;
# missing Copernicus tiles there 404 and are skipped).
DEM_MIN_LAT=48
DEM_MAX_LAT=59
DEM_MIN_LON_W=114
DEM_MAX_LON_W=140

# Contour line spacing in metres: every CONTOUR_INTERVAL_M, with heavier
# "index" contours every CONTOUR_INDEX_M.
CONTOUR_INTERVAL_M=20
CONTOUR_INDEX_M=100

# Glyph stacks to self-host. The osm-bright base style asks for "Noto Sans",
# which openmaptiles/fonts does not publish as a prebuilt glyph pack (only
# "Klokantech Noto Sans"), so 06-style.sh remaps those stacks onto Open Sans.
# Keep this list in sync with that remap or labels silently fail to render.
FONT_STACKS="Open Sans Bold,Open Sans Regular,Open Sans Semibold,Open Sans Italic"

