# React Native / Metro 0.84 cannot follow pnpm's default `.pnpm` symlinked
# store on Windows (bundling fails with "Unable to resolve module …/entry").
# A hoisted (npm-style) node_modules puts real package dirs under node_modules
# where Metro's crawler can index them.
node-linker=hoisted
# pnpm hardlinks package files from its store; on this machine those links carry
# a ReparsePoint attribute that Metro 0.84's file crawler treats as a symlink
# and drops from its map. Copy plain files instead so Metro can crawl them.
package-import-method=copy
auto-install-peers=false
strict-peer-dependencies=false
public-hoist-pattern[]=metro
public-hoist-pattern[]=metro-*
