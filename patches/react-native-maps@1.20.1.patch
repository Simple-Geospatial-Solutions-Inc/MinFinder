-    [_reactSubviews insertObject:(UIView *)subview atIndex:(NSUInteger) atIndex];
+    // Guard against a nil subview and an out-of-range index. Under the New
+    // Architecture's legacy view-manager interop, rapid marker add/remove (e.g.
+    // cluster markers re-rendering on zoom) can hand this method a nil subview,
+    // and -[__NSArrayM insertObject:atIndex:] throws on nil -> SIGABRT.
+    // See react-native-maps PR #5230 / issues #5217, #5345.
+    if (subview != nil) {
+        NSUInteger safeIndex = MIN((NSUInteger)atIndex, _reactSubviews.count);
+        [_reactSubviews insertObject:(UIView *)subview atIndex:safeIndex];
+    }
