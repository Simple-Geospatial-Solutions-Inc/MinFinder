{
  "expo": {
    "name": "SGS MinFinder",
    "slug": "sgs-minfinder",
    "owner": "simple-geospatial-solutions",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-square.png",
    "scheme": "sgs-minfinder",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/10e37699-3c1a-495f-b49b-cc856866e691",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "ca.sgss.minfinder",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "SGS MinFinder uses your location to center the map, to indicate the direction and distance to selected MINFILE occurrences, and to record where a mine you add was found.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SGS MinFinder uses your location to center the map, to indicate the direction and distance to selected MINFILE occurrences, and to record where a mine you add was found."
      },
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "ca.sgss.minfinder",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F2034"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon-square.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SGS MinFinder uses your location to center the map, to indicate the direction and distance to selected MINFILE occurrences, and to record where a mine you add was found."
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SGS MinFinder uses the camera to photograph a mine you add, as proof of what's there.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.444119579996-srbacl2iiu9krhksg3ca49jg0g0be02k"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#0F2034",
          "ios": {
            "imageWidth": 380
          },
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0F2034"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "10e37699-3c1a-495f-b49b-cc856866e691"
      }
    }
  }
}
